# Default image for docker-isolated tool sandboxes (isolation.mode: docker).
# One long-lived container per replica; commands run via `docker exec` with
# the replica workspace bind-mounted at /workspace and no network by default.
#   docker build -f Dockerfile.sandbox -t leforge/sandbox:latest .
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git make ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home sandbox
USER 10001
WORKDIR /workspace
CMD ["sleep", "infinity"]
