     "legendFormat": "pub {{graph}}/{{channel}}"
    },
    {
     "refId": "B",
     "expr": "sum by (graph, node, outcome) (rate(leforge_messages_consumed_total[5m]))",
     "legendFormat": "con {{graph}}/{{node}} {{outcome}}"
    }
